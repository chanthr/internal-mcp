# Knowledge MCP — environment variables
# Copy to .env for local dev. On a host (Railway/Fly/VPS), set these as real env vars.
#
# Secrets live HERE. "What to look at" (Drive folders, collection, schema, domains) lives in
# mcp.config.json — see mcp.config.example.json.

# === Config source (what to look at) — pick one, or rely on ./mcp.config.json ===
# Inline JSON (handy on hosts — one env var, no file):
# MCP_CONFIG_JSON={"orgId":"acme","drive":{"roots":[{"id":"...","name":"Docs","source":"dev"}]}}
# Or an explicit file path:
# MCP_CONFIG_PATH=./mcp.config.json

# === Bootstrap (required) — Supabase (auth + server state) ===
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role key — never expose to clients>

# === API key auth ===
# stdio (local dev) only — a single admin key checked at startup:
MCP_DEV_KEY=dev-only-replace-me
# The key a client sends as `Authorization: Bearer <key>`. In http/prod it is validated via the
# validate_mcp_key RPC (see sql/setup.sql). stdio reads MCP_API_KEY once at startup.
MCP_API_KEY=<an admin key you provisioned in mcp_keys>

# === Google Drive (choose one) ===
# A) Service Account (recommended for production)
GOOGLE_APPLICATION_CREDENTIALS=./google-service-account.json
# or inline JSON (deploy-friendly):
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"..."}
# B) OAuth refresh token (single-user fallback) — run: npm run get-token
# GOOGLE_OAUTH_CLIENT_ID=<client_id>.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=<client_secret>
# GOOGLE_OAUTH_REFRESH_TOKEN=<refresh_token>

# === Semantic search (semantic_search_drive) ===
OPENAI_API_KEY=sk-...                 # embeddings (text-embedding-3-small, 1536d)
QDRANT_URL=https://<cluster>.cloud.qdrant.io:6333
QDRANT_API_KEY=<qdrant_api_key>
# QDRANT_COLLECTION=knowledge_v1       # optional override; else config.qdrant.collection

# === Slack (optional, read-only) ===
# SLACK_USER_TOKEN=xoxp-...            # search.messages / search.files (scope: search:read)
# SLACK_BOT_TOKEN=xoxb-...             # conversations.* / files.* (bot must be in the channel)
# SLACK_TOKEN=xox.-...                 # common fallback

# === GitHub (optional) — repo_tree + github_* upstream ===
# GITHUB_PAT=github_pat_...            # fine-grained: Contents(read), Metadata(read)

# === Railway (optional) — railway_* ===
# RAILWAY_TOKEN=<account_token>

# === OAuth 2.1 (optional — for custom connectors like Claude web) ===
# MCP_OAUTH_ISSUER=https://mcp.example.com
# MCP_RESOURCE=https://mcp.example.com/mcp
# OAUTH_GOOGLE_CLIENT_ID=<client_id>.apps.googleusercontent.com
# OAUTH_GOOGLE_CLIENT_SECRET=<client_secret>
# OAUTH_JWT_SECRET=<random string, >= 32 chars>
# OAUTH_ALLOWED_HD=example.com         # or set config.oauth.allowedDomains
# OAUTH_ALLOWED_EMAILS=a@example.com,b@example.com

# === Server ===
MCP_TRANSPORT=http                     # http (production) | stdio (local dev)
PORT=8080
