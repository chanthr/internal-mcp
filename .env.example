# Knowledge MCP — environment variables
# Copy to .env for local dev. On a host (Docker/Railway/Fly/VPS), set these as real env vars.
# Nothing here is required: with no env at all the server starts with a local SQLite store and only `ping`.
# Each built-in plugin turns on when its section below is filled in (`knowledge-mcp doctor` shows which).
#
# Secrets live HERE. "What to look at" (Drive folders, collection, schema, domains) lives in
# mcp.config.json — see mcp.config.example.json.

# === Config source (what to look at) — pick one, or rely on ./mcp.config.json ===
# Inline JSON (handy on hosts — one env var, no file):
# MCP_CONFIG_JSON={"orgId":"acme","drive":{"roots":[{"id":"...","name":"Docs","source":"dev"}]}}
# Or an explicit file path:
# MCP_CONFIG_PATH=./mcp.config.json

# === Store (keys, users, OAuth tokens, plugin state, audit log) ===
# Default: a SQLite file at <data dir>/knowledge-mcp.db. In Docker, mount a volume at /data.
# MCP_DATA_DIR=./data
# MCP_TOOL_LOG_DAYS=90                 # SQLite keeps this many days of tool-call log
# Supabase instead (shared Postgres; run packages/knowledge-mcp/sql/supabase.sql first). Setting both
# SUPABASE_* values picks Supabase automatically; MCP_STORE forces one or the other.
# MCP_STORE=sqlite|supabase
# SUPABASE_URL=https://<your-project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service role key — never expose to clients>

# === API keys ===
# Create keys with the CLI (only a hash is stored; the key is printed once):
#   knowledge-mcp keys create --email you@example.com --role admin
# HTTP clients send `Authorization: Bearer <key>`.
# stdio: without MCP_API_KEY the process runs as the local admin (whoever starts it already holds the env).
#        Set MCP_API_KEY to run as that key's person instead.
# MCP_API_KEY=

# === Google Drive (choose one) ===
# A) Service Account (recommended for production)
#    File path — local runs only. A container does not include this file; use the inline form there.
# GOOGLE_APPLICATION_CREDENTIALS=./google-service-account.json
#    Inline JSON (deploy-friendly, works in containers):
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"..."}
# B) OAuth refresh token (single-user fallback) — run: knowledge-mcp drive get-token
#    Drive tools then see everything that user can see; folder rules still apply.
# GOOGLE_OAUTH_CLIENT_ID=<client_id>.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=<client_secret>
# GOOGLE_OAUTH_REFRESH_TOKEN=<refresh_token>

# === Semantic search (semantic_search_drive) + indexing ===
# OPENAI_API_KEY=sk-...               # embeddings (text-embedding-3-small, 1536d)
# QDRANT_URL=https://<cluster>.cloud.qdrant.io:6333
# QDRANT_API_KEY=<qdrant_api_key>
# First full index: knowledge-mcp drive reindex  (then the server keeps it in sync)
# QDRANT_COLLECTION=knowledge_v1       # optional override; else config.qdrant.collection
# DRIVE_SYNC_ENABLED=true              # incremental Drive -> Qdrant sync inside the server (false = off)
# DRIVE_SYNC_INTERVAL_MIN=30
# DRIVE_MAX_FILE_BYTES=50000000        # files above this size are not read or indexed

# === OCR for scanned PDFs and images (optional) — Mathpix ===
# Without these, scanned PDFs and images are skipped. With them, those files are SENT TO MATHPIX
# (a third-party service, billed per page) every time they are indexed or read.
# MATHPIX_APP_ID=<app_id>
# MATHPIX_APP_KEY=<app_key>

# === Slack (optional, read-only) ===
# The two token kinds are never used in place of each other.
# SLACK_BOT_TOKEN=xoxb-...             # read tools: conversations.* / files.* (bot must be in the channel)
#                                      # scopes: channels:history, groups:history, channels:read, groups:read,
#                                      #         files:read, users:read
# SLACK_USER_TOKEN=xoxp-...            # slack_search only (scope: search:read). Needs the bot token too:
#                                      # results are limited to channels the bot is a member of.
# SLACK_TOKEN=xoxb-... or xoxp-...     # fills whichever of the two above is empty, chosen by its prefix

# === GitHub (optional) — repo_tree + github_* upstream ===
# GITHUB_PAT=github_pat_...            # fine-grained: Contents(read), Metadata(read). Pick only the repos
#                                      # every MCP user may browse. (GITHUB_TOKEN is read as a fallback.)
# GITHUB_MCP_INSIDERS=false

# === Railway (optional) — railway_* ===
# RAILWAY_TOKEN=<token>                # prefer a project token scoped to the projects users may inspect
# RAILWAY_MCP_TOKEN= / RAILWAY_MCP_URL= # experimental remote Railway MCP; leave unset

# === OAuth 2.1 (optional — for custom connectors like Claude web) ===
# All five values below plus at least one allowlist are required. If anything is missing, OAuth stays
# off and the boot log names the missing values.
# MCP_OAUTH_ISSUER=https://mcp.example.com     # origin only, no path
# MCP_RESOURCE=https://mcp.example.com/mcp     # optional; defaults to <issuer>/mcp
# OAUTH_GOOGLE_CLIENT_ID=<client_id>.apps.googleusercontent.com
# OAUTH_GOOGLE_CLIENT_SECRET=<client_secret>
# OAUTH_JWT_SECRET=<random string, >= 32 chars>   # e.g. openssl rand -hex 32
# Allowlist — a user may sign in if their email is listed OR their Workspace domain is listed.
# OAUTH_ALLOWED_HD=example.com,example.org         # or config oauth.allowedDomains
# OAUTH_ALLOWED_EMAILS=a@example.com,b@partner.com # or config oauth.allowedEmails

# === Server ===
# MCP_TRANSPORT=http                   # http (default) | stdio — or run `knowledge-mcp serve --stdio`
PORT=8080
# MCP_ENV_FILE=                        # load this file instead of ./.env and <app root>/.env
# TRUST_PROXY=1                        # proxy hops to trust for client IP (rate limits). Behind one proxy
#                                      # (Railway/Fly/Cloud Run/nginx) keep 1. Exposed directly: false.

# === Advanced (optional) — defaults shown ===
# MCP_CORS_ORIGINS=https://claude.ai,https://claude.com
# MCP_RATE_LIMIT_WINDOW_MS=60000
# MCP_RATE_LIMIT_MAX=120               # requests per window per IP
# MCP_RATE_LIMIT_FAIL_MAX=20           # 401 responses per window per IP
# MCP_SESSION_IDLE_MS=1800000
# MCP_SESSION_MAX=1000
# AUTH_CACHE_TTL_MS=60000              # a revoked key keeps working for up to this long
# ACT_AS_ALLOWED_KEY_IDS=              # key ids (knowledge-mcp keys list) allowed to send X-MCP-Act-As-Email (trusted proxies only)
# ACT_AS_CACHE_TTL_MS=60000
# DRIVE_TIMEOUT_MS=15000
# FOLDER_META_TTL_MS=600000            # folder renames/moves take up to this long to affect exclusions
# EMBED_BATCH=128
# EMBED_TIMEOUT_MS=10000
# EMBED_INDEX_RETRIES=5
# EMBED_QUERY_TIMEOUT_MS=5000
# EMBED_QUERY_RETRIES=2
# SLACK_USERMAP_TTL_MS=300000
# SLACK_BOT_MEMBER_TTL_MS=300000
# SLACK_LIST_CACHE_TTL_MS=60000
