{
  "name": "knowledge-mcp",
  "version": "0.2.0",
  "description": "Self-hostable MCP server that exposes your Google Drive, Slack, GitHub and Railway data to any MCP client (Claude, etc.) with OAuth and semantic search.",
  "type": "module",
  "license": "MIT",
  "author": "chanthr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chanthr/internal-mcp.git"
  },
  "homepage": "https://github.com/chanthr/internal-mcp#readme",
  "bugs": {
    "url": "https://github.com/chanthr/internal-mcp/issues"
  },
  "main": "dist/index.js",
  "bin": {
    "knowledge-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:scripts": "tsc -p tsconfig.scripts.json",
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "reindex": "tsx scripts/index_drive.ts",
    "reindex:dry": "tsx scripts/index_drive.ts -- --dry-run",
    "get-token": "tsx scripts/get_oauth_refresh_token.ts"
  },
  "dependencies": {
    "@google/genai": "^2.6.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@qdrant/js-client-rest": "^1.18.0",
    "@supabase/supabase-js": "^2.45.0",
    "@types/express": "^5.0.6",
    "dotenv": "^16.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "googleapis": "^144.0.0",
    "gpt-tokenizer": "^3.4.0",
    "jose": "^5.10.0",
    "mammoth": "^1.12.0",
    "officeparser": "^7.1.0",
    "pdf-parse": "^2.4.5",
    "ws": "^8.21.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "^2.9.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/ws": "^8.18.1",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
