{
  "name": "knowledge-mcp-monorepo",
  "private": true,
  "version": "0.3.0",
  "description": "Knowledge MCP: the @chanthr/knowledge-mcp framework and the create-knowledge-mcp generator.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/knowledge-mcp",
    "packages/create-knowledge-mcp"
  ],
  "scripts": {
    "build": "npm run build -w @chanthr/knowledge-mcp",
    "typecheck": "npm run typecheck -w @chanthr/knowledge-mcp",
    "test": "npm test -w @chanthr/knowledge-mcp && npm test -w create-knowledge-mcp",
    "dev": "npm run dev -w @chanthr/knowledge-mcp",
    "smoke:create": "bash scripts/smoke-create.sh"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
