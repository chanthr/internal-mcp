# ── Server ─────────────────────────────────────────────────────────────────
PORT=8080
# or pass `serve --stdio`
# MCP_TRANSPORT=stdio
# SQLite store and checkpoints (default ./data)
# MCP_DATA_DIR=./data
# proxy hops to trust for the client IP (auth rate limit). Behind one proxy keep 1. Exposed directly: false
# TRUST_PROXY=1
# config inline instead of mcp.config.json (handy in containers)
# MCP_CONFIG_JSON=
# use Supabase instead of the SQLite file
# MCP_STORE=supabase
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Your plugins ───────────────────────────────────────────────────────────
# Put the env vars your plugins read here (declare them in `env: [...]` so the tools stay hidden until set).

# ── Built-in connectors (each turns on when its vars are set) ───────────────
# Google Drive: one of these, plus drive.roots in mcp.config.json
# GOOGLE_SERVICE_ACCOUNT_KEY=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=
# Document search works by keywords with nothing set here. Local folders: `npm run setup -- folder <path>`.
# Optional: an embedding model adds search by meaning.
# OPENAI_API_KEY=
# Optional: keep vectors in Qdrant instead of the local index file (an embedding model is then required).
# QDRANT_URL=
# QDRANT_API_KEY=
# Other embedding provider or a local model (any OpenAI-compatible /embeddings endpoint). After changing the model,
# reindex into a new collection: knowledge-mcp drive reindex --recreate
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_DIM=1024
# EMBEDDING_API_KEY=
# Slack (bot token for reading, user token adds search)
# SLACK_BOT_TOKEN=
# SLACK_USER_TOKEN=
# GitHub (Contents: read). GITHUB_TOKEN is read as a fallback
# GITHUB_PAT=
# Railway (or sign in from the console, Apps: nothing to copy)
# RAILWAY_TOKEN=

# ── Sign-in for Claude and ChatGPT connectors (optional) ──
# The console sets the first two (Connect → Sign-in for connectors); a connector then signs in with a key.
# Google is optional. Guide: https://github.com/chanthr/internal-mcp/blob/main/OAUTH_SETUP.md
# MCP_OAUTH_ISSUER=https://mcp.example.com
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_JWT_SECRET=
# OAUTH_ALLOWED_HD=example.com
